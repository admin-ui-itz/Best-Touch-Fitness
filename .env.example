# ---------------------------------------------------------------------------
# GYM website - environment variables
# Copy to .env.local for development. Never commit real values.
# "Build-time" values are baked into the client bundle (NEXT_PUBLIC_*).
# "Runtime" values are read on the server only and can be changed in Coolify
# without rebuilding.
# ---------------------------------------------------------------------------

# --- Site (build-time) -----------------------------------------------------
# Canonical public origin, no trailing slash. Used for canonical URLs,
# sitemap, Open Graph and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "production" enables search indexing. Anything else (staging, preview,
# development) sends noindex headers and a disallow-all robots.txt.
NEXT_PUBLIC_SITE_ENV=development

# --- Supabase (public values are build-time; service role is runtime) -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Brevo transactional email (runtime, server-only) ---------------------
BREVO_API_KEY=xkeysib-your-key
# Must be a verified sender in Brevo (domain or single address).
BREVO_SENDER_EMAIL=hello@example.com
BREVO_SENDER_NAME=GYM
# Where owner notifications are delivered.
ENQUIRY_NOTIFY_EMAIL=owner@example.com
# Optional: reply-to shown on acknowledgement emails (defaults to sender).
ENQUIRY_REPLY_TO_EMAIL=

# --- Security (runtime, server-only) --------------------------------------
# Random secret (32+ chars) used to hash IP addresses for rate limiting.
ENQUIRY_IP_HASH_SECRET=change-me-to-a-long-random-string
# Bearer token required to call POST /api/email/retry (cron / manual retry).
EMAIL_RETRY_SECRET=change-me-to-another-long-random-string
